# =============================================================================
# NewGrad Radar Environment Variables
# =============================================================================
# Copy this file to .env.local (for Next.js) and set your values.
# For the Python scraper, also copy to scraper/.env
#
# Variables marked [REQUIRED] must be set for the app to function.
# Variables marked [OPTIONAL] enable additional features.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION [REQUIRED]
# -----------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public API key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service role key (NEVER expose in browser - server-side only)
# Required for: scraper database writes, admin API routes
SUPABASE_SERVICE_KEY=eyJ...

# Alternative name used by some API routes
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Python scraper uses this URL (falls back to NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co


# -----------------------------------------------------------------------------
# AI / LLM SERVICES [REQUIRED for AI features]
# -----------------------------------------------------------------------------
# At least one is required for job classification and auto-apply

# Google Gemini API key (free tier: ~60 requests/min)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Alternative name for Google AI key
# GOOGLE_API_KEY=

# Groq API key (free tier, fast inference)
# Get from: https://console.groq.com/keys
# GROQ_API_KEY=

# Ollama model for local LLM (no API key needed)
# Requires Ollama running locally: https://ollama.ai
# OLLAMA_MODEL=llama3.2


# -----------------------------------------------------------------------------
# JOB SOURCE APIs [OPTIONAL]
# -----------------------------------------------------------------------------
# Enable additional job sources for the scraper

# USAJobs API (free - register at https://developer.usajobs.gov/APIRequest/Index)
# USAJOBS_API_KEY=
# USAJOBS_EMAIL=

# Adzuna API (free tier: 1,000 calls/month)
# Register at: https://developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=


# -----------------------------------------------------------------------------
# RECRUITER FINDING APIs [OPTIONAL]
# -----------------------------------------------------------------------------
# Enable recruiter email discovery features

# Hunter.io API (free tier: 25 searches/month)
# https://hunter.io
# HUNTER_API_KEY=

# Apollo.io API (free tier available)
# https://www.apollo.io
# APOLLO_API_KEY=

# Snov.io API
# https://snov.io
# SNOV_CLIENT_ID=
# SNOV_CLIENT_SECRET=

# RocketReach API
# https://rocketreach.co
# ROCKETREACH_API_KEY=


# -----------------------------------------------------------------------------
# EMAIL PROVIDERS [OPTIONAL - pick one]
# -----------------------------------------------------------------------------
# For sending email notifications to users

# Brevo (formerly Sendinblue) - RECOMMENDED
# Free tier: 300 emails/day
# https://www.brevo.com
# BREVO_API_KEY=

# Resend API
# Free tier: 100 emails/day
# https://resend.com
# RESEND_API_KEY=

# AWS SES (for high volume)
# Requires AWS account and verified domain
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Custom SMTP server (works with AWS SES, Gmail, etc.)
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Sender email address (must be verified with your provider)
# FROM_EMAIL=NewGrad Radar <jobs@updates.newgradradar.com>


# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS [OPTIONAL]
# -----------------------------------------------------------------------------
# ntfy.sh integration for push notifications

# Admin ntfy topic for scraper error alerts
# ADMIN_NTFY_TOPIC=


# -----------------------------------------------------------------------------
# CRON / SCHEDULED JOBS [OPTIONAL]
# -----------------------------------------------------------------------------
# Security for API routes called by cron jobs

# Secret to authenticate cron job requests
# Generate with: openssl rand -hex 32
# CRON_SECRET=


# -----------------------------------------------------------------------------
# AUTO-APPLY WORKER [OPTIONAL]
# -----------------------------------------------------------------------------
# Configuration for the auto-apply background worker

# How often to check for pending applications (seconds)
# POLL_INTERVAL=5

# Maximum concurrent browser sessions
# MAX_CONCURRENT=3

# Unique worker identifier
# WORKER_ID=worker-1

# Alternative poll interval for scraper worker
# AUTOAPPLY_POLL_INTERVAL=60

# Run browser in headless mode (true/false)
# AUTOAPPLY_HEADLESS=true


# -----------------------------------------------------------------------------
# DEVELOPMENT [OPTIONAL]
# -----------------------------------------------------------------------------
# These are typically set automatically

# NODE_ENV=development
