{
  "conference": {
    "description": "Diversity and tech conferences (GHC, NSBE, SHPE, AfroTech, etc.)",
    "days_before": 14,
    "days_after": 7,
    "actions": ["scrape_sponsors", "priority_scrape"],
    "priority_boost": 2,
    "notes": "Conference sponsors are actively recruiting. Scrape 2 weeks before for early applications."
  },
  "hackathon": {
    "description": "Major university hackathons (HackMIT, TreeHacks, PennApps, etc.)",
    "days_before": 14,
    "days_after": 3,
    "actions": ["scrape_sponsors"],
    "priority_boost": 1,
    "notes": "Hackathon sponsors target new grads. Shorter post-event window as hiring is immediate."
  },
  "demo_day": {
    "description": "YC Demo Day and similar accelerator events",
    "days_before": 7,
    "days_after": 14,
    "actions": ["refresh_yc_jobs"],
    "priority_boost": 3,
    "notes": "Post Demo Day is prime hiring time for YC companies with fresh funding."
  },
  "funding": {
    "description": "Funding round announcements from news sources",
    "days_after": 7,
    "min_amount_millions": 5,
    "priority_rounds": ["Series A", "Series B", "Series C", "Growth"],
    "actions": ["priority_company_scrape"],
    "priority_boost": 4,
    "notes": "Recently funded companies expand aggressively. Growth stage (A-C) prioritized."
  },
