{
  "manifest_version": 3,
  "name": "NewGrad Radar Autofill Helper",
  "version": "0.2.0",
  "description": "Fills prepared HireRadar application answers in hosted ATS forms for your final review and submission.",
  "host_permissions": [
    "https://*.vercel.app/*", "https://newgradradar.com/*", "http://localhost:*/*"
  ],
  "content_scripts": [{
    "matches": [
      "https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*",
      "https://jobs.lever.co/*", "https://jobs.ashbyhq.com/*",
      "https://*.myworkdayjobs.com/*", "https://*.smartrecruiters.com/*",
      "https://careers.roblox.com/*", "https://careers.withwaymo.com/*",
      "https://www.samsara.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
