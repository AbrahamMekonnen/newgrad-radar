# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python (scraper)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Sensitive EEO/diversity data (privacy protection)
profile.eeo.json
*.eeo.json
auto-apply/profile.json

# Cache directories (tiered cache L2 storage)
.cache/
auto-apply/.cache/

# Scraper generated runtime data (metrics, costs, checkpoints)
scraper/data/monitoring/
scraper/.scraper_state/
.scraper_state/

# Telegram discovered-channel cache (regenerated each run)
scraper/sources/interview_questions/.telegram_channels.json
